# ==============================================================================
# Multi-Forge / ForgeOS — Kernel Performance Patches & Config
# Platform: Amlogic S905X2 (Meson G12A / BTV Express E10)
# Reference: patches_desempenho_s905x2.txt
# ==============================================================================

# 1. MGLRU (Multi-Generational Least Recently Used)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set

# 2. ZRAM Multi-Stream Compression (LZ4 / ZSTD)
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# 3. Software Fast-Path / Netfilter Flow Offloading
CONFIG_NETFILTER_XT_TARGET_FLOWOFFLOAD=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y

# 4. BORE Scheduler (Burst-Oriented Response Enhancer)
CONFIG_SCHED_BORE=y

# 5. I/O Schedulers (Kyber / BFQ for eMMC & SD Card)
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_DEFAULT_KYBER=y

# 6. TCP BBR / BBRv3 Congestion Control
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# 7. Low-Latency Preemption & HZ (300 Hz for Cortex-A53)
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# 8. Hardware Cryptographic Acceleration (ARMv8 CE)
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_SHA1_ARM64_CE=y
CONFIG_CRYPTO_DEV_AMLOGIC_G12A_AES=y
