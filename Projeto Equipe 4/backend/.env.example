# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=coloque_seu_token_aqui
INFLUX_ORG=minha_org
INFLUX_BUCKET=sensores

# Banco local (cadastro de sensores)
SQLITE_PATH=./gateway.db

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS (origens do frontend, separadas por vírgula). Use "*" em desenvolvimento.
CORS_ORIGINS=*
