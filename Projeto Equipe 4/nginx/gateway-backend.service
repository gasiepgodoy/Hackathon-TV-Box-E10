# Copie para /etc/systemd/system/gateway-backend.service e ajuste os caminhos.
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gateway-backend

[Unit]
Description=Gateway IoT - backend Python (FastAPI)
After=network.target influxdb.service
Wants=influxdb.service

[Service]
Type=simple
User=gateway
WorkingDirectory=/opt/gateway-iot/backend
EnvironmentFile=/opt/gateway-iot/backend/.env
ExecStart=/opt/gateway-iot/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
