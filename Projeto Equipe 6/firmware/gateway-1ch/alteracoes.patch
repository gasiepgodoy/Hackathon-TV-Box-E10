# Alteracoes da Equipe 6 sobre o ESP-1ch-Gateway
#
# Base: https://github.com/things4u/ESP-1ch-Gateway  (commit 3b02352, v6.2.8)
# Sao 4 arquivos; os mesmos estao inteiros em ESP-sc-gway/, ja alterados.
#
# A linha do wpa[] em configNode.h esta REDIGIDA: o original traz o SSID e a
# senha do Wi-Fi em texto puro. Preencha com os seus antes de compilar.
#
# Para aplicar sobre uma copia limpa do upstream:
#     git clone https://github.com/things4u/ESP-1ch-Gateway
#     cd ESP-1ch-Gateway && cp -r src ESP-sc-gway && cd ESP-sc-gway
#     git apply -p1 /caminho/alteracoes.patch
#
# Ou, mais simples: copie os quatro arquivos de ESP-sc-gway/ por cima.

--- a/configGway.h
+++ b/configGway.h
@@ -32,6 +32,24 @@
 // how to set these #defines
 //
 // ========================================================================================
+//
+// GATEWAY EUI — nao existe #define para ele.
+//
+// O EUI e montado em runtime a partir do MAC da placa, inserindo DOIS BYTES
+// no meio (ver _udpSemtech.ino, sendPullData() e sendstat()):
+//
+//     MAC 3c:71:bf:6b:8d:c4  ->  EUI  3c71bf FFFF 6b8dc4
+//
+// ATENCAO: este fork usa 0xFF 0xFF como enchimento. A convencao mais comum na
+// literatura LoRaWAN e 0xFF 0xFE — se registrar 3c71bfFFFE6b8dc4 no ChirpStack,
+// o gateway conecta, manda pacote, e o servidor descarta tudo em silencio por
+// EUI desconhecido. Nao aparece erro na placa: o protocolo Semtech UDP nao tem
+// resposta negativa para gateway nao cadastrado.
+//
+// Para conferir o EUI da placa que esta na mesa, abra o Monitor Serial a 115200
+// no boot — a linha "Gateway ID: ..." e impressa em ESP-sc-gway.ino.
+//
+// ========================================================================================
 
 
 // Define whether we should do a formatting of SPIFFS when starting the gateway
@@ -87,7 +105,10 @@
 // AS923		(Not Used)
 // You can find the definitions in "loraModem.h" and frequencies in
 // See https://www.thethingsnetwork.org/docs/lorawan/frequency-plans.html
-#define EU863_870 1
+// Brasil usa LA915, derivado do AU915. A tabela de frequencias em loraModem.h
+// para AU925_928 comeca em 916.8 MHz, que no plano AU915 e o canal 8 — ou seja,
+// SUB-BANDA 2. Por isso o ChirpStack precisa estar na regiao "au915_1".
+#define AU925_928 1
  
 
 // Define the CLASS mode of the gateway
@@ -116,8 +137,10 @@
 // This parameters contains the default value of SF, the actual version can be set with
 // the webserver and it will be stored in SPIFF
 // NOTE: The frequency is set in the loraModem.h file and is default 868100000 Hz.
+// SF7 para casar com o no (_SF_TRABALHO = DR_SF7 no firmware do sensor).
+// Gateway de canal unico so recebe se frequencia E spreading factor baterem.
 #if !defined _SPREADING
-#	define _SPREADING SF9
+#	define _SPREADING SF7
 #endif
 
 // Channel Activity Detection
@@ -167,7 +190,7 @@
