# Credenciais SMTP do microserviço de saída. Copie para .env (que NÃO é
# versionado) e carregue no systemd com EnvironmentFile=/opt/secbox-push/.env
#
# Provedor: use um serviço transacional (Brevo, Mailgun, SendGrid — todos com
# plano gratuito suficiente para um piloto). E-mail saindo direto de IP
# residencial ou de universidade costuma cair em spam, e aí a recuperação de
# conta falha justamente para quem precisa dela.
#
# Gmail funciona para teste, mas exige 2FA ligado e uma "senha de app" —
# a senha normal da conta é recusada.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SecBox <nao-responda@seu-dominio>"
